        "temperature": {"addr": 20, "count": 1, "note": "干燥温度(℃)"}
      }
    },
    "gravure1": {
      "name": "凹印机1#（卷膜印刷·佛山）",
      "type": "modbus_tcp",
      "host": "192.168.1.11",
      "port": 502,
      "unit": 1,
      "line": "L2",
      "registers": {
        "qty": {"addr": 100, "count": 2, "note": "本卷数量(米)"},
