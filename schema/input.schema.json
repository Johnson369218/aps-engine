{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "APS Engine 输入契约",
 "version": "1.0.0",
 "type": "object",
 "required": [
  "orders",
  "lines",
  "products"
 ],
 "properties": {
  "orders": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/order"
   },
   "minItems": 1
  },
  "lines": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/line"
   },
   "minItems": 1
  },
  "products": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/product"
   },
   "minItems": 1
  }
 },
 "$defs": {
  "order": {
   "type": "object",
   "required": [
    "id",
    "product",
    "qty",
    "due"
   ],
   "properties": {
    "id": {
     "type": "string"
    },
    "product": {
     "type": "string"
    },
    "qty": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "due": {
     "type": "string",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}( \\d{2}:\\d{2})?$"
    },
    "priority": {
     "type": "integer",
     "enum": [
      1,
      2,
      3
     ]
    },
    "allowed_lines": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "release": {
     "type": "string"
    },
    "duration_min": {
     "type": "number",
     "exclusiveMinimum": 0
    }
   }
  },
  "line": {
   "type": "object",
   "required": [
    "id",
    "name"
   ],
   "properties": {
    "id": {
     "type": "string"
    },
    "name": {
     "type": "string"
    },
    "work_minutes_per_day": {
     "type": "integer",
     "minimum": 1,
     "default": 480
    },
    "shift_start": {
     "type": "string",
     "pattern": "^\\d{2}:\\d{2}$",
     "default": "08:00"
    },
    "first_date": {
     "type": "string",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "weekends_off": {
     "type": "boolean",
     "default": true
    },
    "capacity": {
     "type": "integer",
     "minimum": 1,
     "default": 1
    }
   }
  },
  "product": {
   "type": "object",
   "required": [
    "id",
    "name"
   ],
   "properties": {
    "id": {
     "type": "string"
    },
    "name": {
     "type": "string"
    },
    "unit": {
     "type": "string",
     "default": ""
    },
    "speed_per_hour": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "capacity_8h": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "overhead_min": {
     "type": "number",
     "minimum": 0,
     "default": 0
    },
    "setup_min": {
     "type": "object"
    },
    "default_setup_min": {
     "type": "number",
     "minimum": 0,
     "default": 30
    }
   }
  }
 }
}